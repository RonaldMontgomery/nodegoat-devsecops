#!/bin/bash
# First-boot setup for the NodeGoat host (Ubuntu 24.04). No SSH keys; managed through SSM only.
# Deployments arrive later through the nodegoat-deploy SSM document.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends docker.io docker-compose-v2 jq curl ca-certificates
systemctl enable --now docker

# AWS CLI from the snap published by AWS (used to read Secrets Manager).
snap install aws-cli --classic

# Cosign, pinned by version and SHA-256, to verify image signatures on the host itself.
curl --fail --silent --show-error --location --retry 5 --output /tmp/cosign \
  "https://github.com/sigstore/cosign/releases/download/${cosign_version}/cosign-linux-amd64"
echo "${cosign_sha256}  /tmp/cosign" | sha256sum --check --strict
install -m 0755 /tmp/cosign /usr/local/bin/cosign
rm -f /tmp/cosign

install -d -m 0755 /opt/nodegoat /opt/nodegoat/artifacts
