{
  "name": "owasp-nodejs-goat",
  "private": true,
  "version": "1.3.0",
  "description": "A tool to learn OWASP Top 10 for node.js developers",
  "main": "server.js",
  "dependencies": {
    "body-parser": "^1.15.1",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "marked": "^18.3.0",
    "mongodb": "^7.8.0",
    "needle": "2.2.4",
    "nunjucks": "^3.2.4",
    "serve-favicon": "^2.3.0",
    "underscore": "^1.13.8"
  },
  "comments": {
    "//": "a9 insecure components"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env PORT=5000 node --watch server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test/ci/*.test.js",
    "lint": "eslint .",
    "db:seed": "cross-env NODE_ENV=test node artifacts/db-reset.js",
    "precommit": "npm run lint",
    "docker-mongo": "docker run -p 127.0.0.1:27017:27017 --name mongo mongo:8.0",
    "start-infra": "docker-compose up",
    "stop-infra": "docker-compose down"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0"
  },
  "repository": "https://github.com/OWASP/NodejsGoat",
  "license": "Apache 2.0"
}
